{
  "name": "@lucentis/lantern",
  "description": "Headless primitives and themeable Vue 3 components",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Lucentis <lucentis.dev@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucentis-lab/lantern"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "headless",
    "components",
    "design-system",
    "tailwind",
    "theming"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/lantern.cjs.js",
  "module": "./dist/lantern.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lantern.es.js",
      "require": "./dist/lantern.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --emitDeclarationOnly",
    "test": "vitest",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "lodash-es": "^4.17.21"
  },
  "dependencies": {
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.2"
  }
}
